    <!-- Decoder -->
    <string name="settings_category_decoder">Decoder</string>
    <string name="settings_improved_decoder">Experimental decoder (JS8Call-improved)</string>
    <string name="settings_improved_decoder_summary">The newest desktop decoder: soft combining of repeats, coherent demodulation, interference cancelling. In bench tests it decodes the same as the standard decoder and uses about twice the CPU. Try it on the air and compare.</string>
