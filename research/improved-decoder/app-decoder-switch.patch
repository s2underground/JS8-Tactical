          * @param submodes Bitmask of enabled submodes
          * @param callbackHandler Handler for engine events
          */
+        /**
+         * Use the JS8Call-improved decoder (true) or the standard one (false).
+         * Process-wide; takes effect from the next decode pass.
+         */
+        fun setImprovedDecoder(enabled: Boolean) {
+            if (nativeHasImprovedDecoder()) nativeSetImprovedDecoder(enabled)
+        }
+
+        /** True when the native library was built with the JS8Call-improved decoder. */
+        fun hasImprovedDecoder(): Boolean = nativeHasImprovedDecoder()
+
+        private external fun nativeSetImprovedDecoder(enabled: Boolean)
+        private external fun nativeHasImprovedDecoder(): Boolean
+
