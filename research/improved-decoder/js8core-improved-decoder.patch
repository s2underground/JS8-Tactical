diff --git a/src/decoder/improved/compat/boost/crc.hpp b/src/decoder/improved/compat/boost/crc.hpp
new file mode 100644
index 0000000..ab977a1
--- /dev/null
+++ b/src/decoder/improved/compat/boost/crc.hpp
@@ -0,0 +1,23 @@
+// boost::augmented_crc<12, 0xc06> as used by the JS8 decoder (CRC-12 over the
+// whole buffer, augmented form: no reflection, zero initial value).
+#pragma once
+#include <cstddef>
+#include <cstdint>
+namespace boost {
+template <std::size_t Bits, std::uint32_t TruncPoly>
+std::uint32_t augmented_crc(void const *buffer, std::size_t byte_count) {
+    constexpr std::uint32_t top = 1u << (Bits - 1);
+    constexpr std::uint32_t mask = (Bits >= 32) ? 0xFFFFFFFFu : ((1u << Bits) - 1u);
+    auto const *p = static_cast<std::uint8_t const *>(buffer);
+    std::uint32_t rem = 0;
+    for (std::size_t i = 0; i < byte_count; ++i) {
+        for (int b = 7; b >= 0; --b) {
+            bool const in = (p[i] >> b) & 1u;
+            bool const msb = (rem & top) != 0;
+            rem = ((rem << 1) | (in ? 1u : 0u)) & mask;
+            if (msb) rem ^= TruncPoly;
+        }
+    }
+    return rem & mask;
+}
+} // namespace boost
diff --git a/src/decoder/improved/compat/boost/math/ccmath/round.hpp b/src/decoder/improved/compat/boost/math/ccmath/round.hpp
new file mode 100644
index 0000000..4c53beb
--- /dev/null
+++ b/src/decoder/improved/compat/boost/math/ccmath/round.hpp
@@ -0,0 +1,11 @@
+// boost::math::ccmath::round: round half away from zero, usable at compile
+// time (std::round is constexpr only as a GCC extension; NDK clang needs this).
+#pragma once
+#include <type_traits>
+namespace boost::math::ccmath {
+template <typename T>
+constexpr std::enable_if_t<std::is_floating_point_v<T>, T> round(T x) noexcept {
+    return x >= T(0) ? T(static_cast<long long>(x + T(0.5)))
+                     : T(static_cast<long long>(x - T(0.5)));
+}
+} // namespace boost::math::ccmath
