diff --git a/tools/decoder_compare.cpp b/tools/decoder_compare.cpp
new file mode 100644
index 0000000..81b404b
--- /dev/null
+++ b/tools/decoder_compare.cpp
@@ -0,0 +1,307 @@
+// Side-by-side test of js8core's legacy decoder and the JS8Call-improved
+// decoder on identical synthetic signals. Scenario design follows upstream's
+// tools/decoder_comparison_benchmark.cpp (JS8Call-improved, GPLv3).
+//
+//   js8core-decoder-compare [trials=40] [modes=ABCE]
+//
+// SNR is in the 2500 Hz reference bandwidth JS8 reports. Each trial runs in
+// a fresh thread so both decoders start with no history, except "repeat",
+// which sends the same frame in two successive periods inside one trial.
+
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <complex>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <random>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "js8core/decoder.hpp"
+#include "js8core/protocol/constants.hpp"
+#include "js8core/protocol/costas.hpp"
+
+using namespace js8core;
+
+namespace {
+
+constexpr int kRate = 12000;
+constexpr int kSymbols = 79;
+constexpr double kPi = 3.14159265358979323846;
+
+struct TestMode {
+    char name;
+    int bit;
+    int nsps;
+    int seconds;
+    double start_s;
+    protocol::CostasType costas;
+    std::vector<double> snrs;
+};
+
+std::array<char const *, 6> const kMessages = {"TESTTEST1234", "TESTTEST1235", "AAAAAAAAAAAA",
+                                               "ZZZZZZZZZZZZ", "ABCDEFGH1234", "0123456789AB"};
+
+struct Station {
+    int message;
+    double freq;
+    double rel_db;       // power relative to the first station
+    double offset_sym;   // timing offset, symbols
+    double drift_hz_s;   // linear frequency drift
+};
+
+// Real FSK signal, phase-continuous, random start phase, plus white noise.
+std::vector<std::int16_t> synth(TestMode const &m, std::vector<Station> const &stations, double snr_db,
+                                std::uint32_t seed) {
+    std::vector<double> x(static_cast<std::size_t>(protocol::kJs8NtMax * kRate), 0.0);
+    double const sigma = 1000.0;
+    double const amp0 = std::sqrt(2.0 * sigma * sigma * (2500.0 / 6000.0) * std::pow(10.0, snr_db / 10.0));
+    double const baud = static_cast<double>(kRate) / m.nsps;
+    std::mt19937 rng(seed);
+    std::uniform_real_distribution<double> ph(-kPi, kPi);
+    for (auto const &s : stations) {
+        std::array<int, kSymbols> tones{};
+        legacy_encode(0, protocol::costas(m.costas), kMessages[static_cast<std::size_t>(s.message)], tones.data());
+        double const amp = amp0 * std::pow(10.0, s.rel_db / 20.0);
+        int const start = static_cast<int>(std::lround((m.start_s + s.offset_sym * m.nsps / kRate) * kRate));
+        double phase = ph(rng);
+        for (int k = 0; k < kSymbols; ++k) {
+            for (int n = 0; n < m.nsps; ++n) {
+                int const idx = start + k * m.nsps + n;
+                double const t = static_cast<double>(k * m.nsps + n) / kRate;
+                double const f = s.freq + tones[static_cast<std::size_t>(k)] * baud + s.drift_hz_s * t;
+                phase += 2.0 * kPi * f / kRate;
+                if (idx >= 0 && idx < m.seconds * kRate) x[static_cast<std::size_t>(idx)] += amp * std::cos(phase);
+            }
+        }
+    }
+    std::normal_distribution<double> noise(0.0, sigma);
+    std::vector<std::int16_t> out(x.size(), 0);
+    for (int i = 0; i < m.seconds * kRate; ++i) {
+        double const v = std::clamp(x[static_cast<std::size_t>(i)] + noise(rng), -32768.0, 32767.0);
+        out[static_cast<std::size_t>(i)] = static_cast<std::int16_t>(std::lround(v));
+    }
+    return out;
+}
+
+using DecodeFn = std::function<std::size_t(DecodeState const &, std::function<void(events::Variant const &)>)>;
+
+struct Outcome {
+    unsigned found_mask = 0;
+    int false_decodes = 0;
+    double ms = 0;
+};
+
+Outcome decode(DecodeFn const &fn, TestMode const &m, std::vector<std::int16_t> samples, unsigned expected) {
+    DecodeState st;
+    st.samples = std::move(samples);
+    st.params.nfqso = 1500;
+    st.params.nfa = 1000;
+    st.params.nfb = 2000;
+    st.params.nsubmodes = 1 << m.bit;
+    int const sz = m.seconds * kRate;
+    switch (m.bit) {
+    case 0: st.params.kszA = sz; break;
+    case 1: st.params.kszB = sz; break;
+    case 2: st.params.kszC = sz; break;
+    case 3: st.params.kszE = sz; break;
+    default: st.params.kszI = sz; break;
+    }
+    Outcome o;
+    auto const t0 = std::chrono::steady_clock::now();
+    fn(st, [&](events::Variant const &ev) {
+        if (auto const *d = std::get_if<events::Decoded>(&ev)) {
+            bool hit = false;
+            for (std::size_t i = 0; i < kMessages.size(); ++i) {
+                if (d->data == kMessages[i] && (expected & (1u << i))) { o.found_mask |= 1u << i; hit = true; }
+            }
+            if (!hit) ++o.false_decodes;
+        }
+    });
+    o.ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    return o;
+}
+
+DecodeFn const kLegacy = [](DecodeState const &s, std::function<void(events::Variant const &)> e) {
+    return legacy_decode(s, std::move(e));
+};
+DecodeFn const kImproved = [](DecodeState const &s, std::function<void(events::Variant const &)> e) {
+    return improved_decode(s, std::move(e));
+};
+
+template <typename F> void in_fresh_thread(F f) { std::thread(f).join(); }
+
+struct Tally {
+    int found = 0, expected = 0, falses = 0;
+    double ms = 0;
+    int runs = 0;
+};
+
+void row(char const *label, Tally const &a, Tally const &b) {
+    std::printf("  %-28s legacy %3d/%-3d  improved %3d/%-3d  (false %d/%d, ms %.0f/%.0f)\n", label, a.found,
+                a.expected, b.found, b.expected, a.falses, b.falses, a.ms / std::max(1, a.runs),
+                b.ms / std::max(1, b.runs));
+    std::fflush(stdout);
+}
+
+int popcount(unsigned v) { return __builtin_popcount(v); }
+
+void scenario(char const *label, TestMode const &m, int trials, double snr,
+              std::function<std::vector<Station>(int trial)> make) {
+    Tally a, b;
+    for (int t = 0; t < trials; ++t) {
+        auto const stations = make(t);
+        unsigned expected = 0;
+        for (auto const &s : stations) expected |= 1u << s.message;
+        auto const samples = synth(m, stations, snr, 0x3722026u + 7919u * static_cast<unsigned>(t));
+        in_fresh_thread([&] {
+            auto o = decode(kLegacy, m, samples, expected);
+            a.found += popcount(o.found_mask); a.expected += popcount(expected); a.falses += o.false_decodes; a.ms += o.ms; ++a.runs;
+        });
+        in_fresh_thread([&] {
+            auto o = decode(kImproved, m, samples, expected);
+            b.found += popcount(o.found_mask); b.expected += popcount(expected); b.falses += o.false_decodes; b.ms += o.ms; ++b.runs;
+        });
+    }
+    row(label, a, b);
+}
+
+// The same frame in two successive periods; counts a decode in either.
+void repeat_scenario(TestMode const &m, int trials, double snr) {
+    Tally a, b;
+    for (int t = 0; t < trials; ++t) {
+        std::vector<Station> s{{t % 6, 1503.7 + (t % 7) * 13.1, 0, 0, 0}};
+        unsigned const expected = 1u << s[0].message;
+        auto const p1 = synth(m, s, snr, 0x51u + 31u * static_cast<unsigned>(t));
+        auto const p2 = synth(m, s, snr, 0x9e37u + 31u * static_cast<unsigned>(t));
+        for (int which = 0; which < 2; ++which) {
+            Tally &tl = which == 0 ? a : b;
+            DecodeFn const &fn = which == 0 ? kLegacy : kImproved;
+            in_fresh_thread([&] {
+                auto o1 = decode(fn, m, p1, expected);
+                auto o2 = decode(fn, m, p2, expected);
+                tl.found += popcount(o1.found_mask | o2.found_mask);
+                tl.expected += 1;
+                tl.falses += o1.false_decodes + o2.false_decodes;
+                tl.ms += o1.ms + o2.ms; tl.runs += 2;
+            });
+        }
+    }
+    char label[64];
+    std::snprintf(label, sizeof label, "repeat x2 @ %.0f dB", snr);
+    row(label, a, b);
+}
+
+} // namespace
+
+// 16-bit mono 12 kHz WAV (as in JS8Call-improved media/tests); mode from the
+// first letter of the file name. Prints what each decoder found.
+int wav_main(int argc, char **argv) {
+    int total_a = 0, total_b = 0;
+    for (int i = 1; i < argc; ++i) {
+        std::FILE *f = std::fopen(argv[i], "rb");
+        if (!f) { std::printf("cannot open %s\n", argv[i]); return 1; }
+        std::vector<char> bytes;
+        char buf[65536];
+        std::size_t got;
+        while ((got = std::fread(buf, 1, sizeof buf, f)) > 0) bytes.insert(bytes.end(), buf, buf + got);
+        std::fclose(f);
+        // Find the "data" chunk.
+        std::size_t pos = 12, data_at = 0, data_len = 0;
+        while (pos + 8 <= bytes.size()) {
+            std::uint32_t len = 0;
+            std::memcpy(&len, &bytes[pos + 4], 4);
+            if (std::memcmp(&bytes[pos], "data", 4) == 0) { data_at = pos + 8; data_len = len; break; }
+            pos += 8 + len + (len & 1);
+        }
+        data_len = std::min(data_len, bytes.size() - data_at);
+        std::vector<std::int16_t> samples(static_cast<std::size_t>(protocol::kJs8NtMax * kRate), 0);
+        std::size_t const n = std::min(samples.size(), data_len / 2);
+        std::memcpy(samples.data(), &bytes[data_at], n * 2);
+        std::string const name = argv[i];
+        char const mode_letter = name[name.find_last_of('/') == std::string::npos ? 0 : name.find_last_of('/') + 1];
+        TestMode m{'A', 0, 1920, 15, 0.5, protocol::CostasType::Original, {}};
+        if (mode_letter == 'E') m = TestMode{'E', 3, 3840, 30, 0.5, protocol::CostasType::Modified, {}};
+        if (mode_letter == 'B') m = TestMode{'B', 1, 1200, 10, 0.2, protocol::CostasType::Modified, {}};
+        if (mode_letter == 'C') m = TestMode{'C', 2, 600, 6, 0.1, protocol::CostasType::Modified, {}};
+        for (int which = 0; which < 2; ++which) {
+            std::vector<std::string> found;
+            double ms = 0;
+            in_fresh_thread([&] {
+                DecodeState st;
+                st.samples = samples;
+                st.params.nfqso = 1500; st.params.nfa = 200; st.params.nfb = 3000;
+                st.params.nsubmodes = 1 << m.bit;
+                int const sz = static_cast<int>(std::min<std::size_t>(n, static_cast<std::size_t>(m.seconds * kRate)));
+                if (m.bit == 0) st.params.kszA = sz; else if (m.bit == 1) st.params.kszB = sz;
+                else if (m.bit == 2) st.params.kszC = sz; else st.params.kszE = sz;
+                auto const t0 = std::chrono::steady_clock::now();
+                (which == 0 ? kLegacy : kImproved)(st, [&](events::Variant const &ev) {
+                    if (auto const *d = std::get_if<events::Decoded>(&ev)) {
+                        char line[96];
+                        std::snprintf(line, sizeof line, "%4.0f Hz %+3d dB %s", d->frequency, d->snr, d->data.c_str());
+                        found.push_back(line);
+                    }
+                });
+                ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+            });
+            (which == 0 ? total_a : total_b) += static_cast<int>(found.size());
+            std::printf("%s %-9s %zu decodes, %.0f ms\n", name.substr(name.find_last_of('/') + 1).c_str(),
+                        which == 0 ? "legacy" : "improved", found.size(), ms);
+            for (auto const &l : found) std::printf("      %s\n", l.c_str());
+        }
+    }
+    std::printf("TOTAL legacy %d, improved %d\n", total_a, total_b);
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    if (argc > 1 && std::string(argv[1]).find(".wav") != std::string::npos) return wav_main(argc, argv);
+    int const trials = argc > 1 ? std::atoi(argv[1]) : 40;
+    std::string const which = argc > 2 ? argv[2] : "ABCE";
+
+    std::vector<TestMode> const modes = {
+        {'A', 0, 1920, 15, 0.5, protocol::CostasType::Original, {-16, -18, -19, -20, -21, -22, -23}},
+        {'B', 1, 1200, 10, 0.2, protocol::CostasType::Modified, {-14, -16, -17, -18, -19, -20, -21}},
+        {'C', 2, 600, 6, 0.1, protocol::CostasType::Modified, {-11, -13, -14, -15, -16, -17, -18}},
+        {'E', 3, 3840, 30, 0.5, protocol::CostasType::Modified, {-19, -21, -22, -23, -24, -25, -26}},
+    };
+
+    for (auto const &m : modes) {
+        if (which.find(m.name) == std::string::npos) continue;
+        std::printf("Mode %c (%d trials per row)\n", m.name, trials);
+        for (double snr : m.snrs) {
+            char label[64];
+            std::snprintf(label, sizeof label, "single @ %.0f dB", snr);
+            scenario(label, m, trials, snr, [](int t) {
+                return std::vector<Station>{{t % 6, 1503.7 + (t % 7) * 13.1, 0, 0.0, 0}};
+            });
+        }
+        double const mid = m.snrs[m.snrs.size() / 2];
+        double const baud = static_cast<double>(kRate) / m.nsps;
+        char label[64];
+        std::snprintf(label, sizeof label, "drift 0.05 Hz/s @ %.0f dB", mid + 2);
+        scenario(label, m, trials, mid + 2, [](int t) {
+            return std::vector<Station>{{t % 6, 1503.7, 0, 0.0, 0.05}};
+        });
+        std::snprintf(label, sizeof label, "late 0.4 sym @ %.0f dB", mid + 2);
+        scenario(label, m, trials, mid + 2, [](int t) {
+            return std::vector<Station>{{t % 6, 1503.7, 0, 0.4, 0}};
+        });
+        std::snprintf(label, sizeof label, "2 stations 1.5 baud, -6 dB");
+        scenario(label, m, trials, m.snrs[0], [baud](int t) {
+            return std::vector<Station>{{t % 6, 1503.7, 0, 0.0, 0}, {(t + 1) % 6, 1503.7 + 1.5 * baud, -6, 0.03, 0}};
+        });
+        std::snprintf(label, sizeof label, "3 stations 1 baud apart");
+        scenario(label, m, trials, m.snrs[0], [baud](int t) {
+            return std::vector<Station>{{t % 6, 1503.7, 0, 0.0, 0}, {(t + 1) % 6, 1503.7 + baud, -3, 0.03, 0},
+                                        {(t + 2) % 6, 1503.7 + 2 * baud, -6, 0.06, 0}};
+        });
+        repeat_scenario(m, trials, m.snrs[m.snrs.size() - 2]);
+    }
+    return 0;
+}
