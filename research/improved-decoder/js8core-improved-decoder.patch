+#!/usr/bin/env bash
+# Copy the JS8Call-improved decoder into core/vendor/js8call-improved.
+#
+#   tools/js8i/sync_from_upstream.sh /path/to/JS8Call-improved
+#
+# Files are copied unchanged, with one exception: JS8.cpp loses its Qt thread
+# wrapper (the "Worker" and "Public Interface - Decoding" sections, which need
+# QObject/moc). Everything the decoder itself needs is kept. Qt logging, FFTW
+# and the few Boost helpers are supplied by small stand-ins in
+# src/decoder/improved/compat/. The upstream commit is recorded in UPSTREAM.md.
+set -euo pipefail
+src="${1:?path to a JS8Call-improved checkout}"
+here="$(cd "$(dirname "$0")/../.." && pwd)"
+dst="$here/vendor/js8call-improved"
+rm -rf "$dst"; mkdir -p "$dst/JS8_Mode"
+
+headers=(bp_math.h coherent_likelihood.h decoder_aided_redemod.h FrequencyTracker.h
+         ldpc_feedback.h optional_work.h sic_refinement.h soft_combiner.h whitening_processor.h)
+for h in "${headers[@]}" FrequencyTracker.cpp; do cp "$src/JS8_Mode/$h" "$dst/JS8_Mode/$h"; done
+
+# Drop from the "Worker" banner up to (not including) the "Public Interface - Encoding" banner.
+awk '
+  /^\/\*+\/$/ { banner = $0; getline title;
+                if (title ~ /^\/\/ Worker$/) { skipping = 1 }
+                if (title ~ /^\/\/ Public Interface - Encoding$/) { skipping = 0 }
+                if (!skipping) { print banner; print title }
+                next }
+  !skipping { print }
+' "$src/JS8_Mode/JS8.cpp" > "$dst/JS8_Mode/JS8.cpp"
+grep -q "class Worker" "$dst/JS8_Mode/JS8.cpp" && { echo "cut failed: Worker still present" >&2; exit 1; }
+grep -q "^void encode(int const type" "$dst/JS8_Mode/JS8.cpp" || { echo "cut failed: encode() missing" >&2; exit 1; }
+
+cp "$src/LICENSE" "$dst/LICENSE"
+rev="$(git -C "$src" rev-parse HEAD 2>/dev/null || echo unknown)"
+date="$(git -C "$src" log -1 --format=%cd --date=short 2>/dev/null || echo unknown)"
+cat > "$dst/UPSTREAM.md" <<MD
+# JS8Call-improved decoder (vendored)
+
+Source: https://github.com/JS8Call-improved/JS8Call-improved
+Commit: $rev ($date)
+License: GPLv3 (see LICENSE), the same as this project.
+
+Copied by \`core/tools/js8i/sync_from_upstream.sh\`. Files are unchanged, except
+that \`JS8_Mode/JS8.cpp\` has its Qt thread wrapper removed (sections "Worker"
+and "Public Interface - Decoding"). Do not edit these files by hand: change the
+stand-ins in \`core/src/decoder/improved/compat/\` or re-run the script.
+MD
+echo "Synced $rev into $dst"
