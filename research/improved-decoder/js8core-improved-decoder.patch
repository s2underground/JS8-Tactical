diff --git a/src/decoder/improved/improved_decoder.cpp b/src/decoder/improved/improved_decoder.cpp
new file mode 100644
index 0000000..1d9591f
--- /dev/null
+++ b/src/decoder/improved/improved_decoder.cpp
@@ -0,0 +1,173 @@
+// js8core entry point for the JS8Call-improved decoder.
+//
+// The upstream decoder (vendor/js8call-improved, GPLv3) is compiled in this
+// translation unit unchanged; Qt logging, FFTW and the Boost helpers it uses
+// come from the stand-ins in compat/. This file only replaces upstream's Qt
+// Worker: it keeps one decoder per submode alive between calls (soft combining
+// and frequency tracking need that history), converts js8core::DecodeState to
+// upstream's dec_data, and converts upstream events to js8core events.
+
+#include "js8core/decoder.hpp"
+
+#include <array>
+#include <chrono>
+#include <memory>
+#include <mutex>
+#include <variant>
+
+#include "JS8_Mode/JS8.cpp"
+
+#undef fftw_mutex // compat/commons.h maps the upstream global onto this function
+namespace js8core::improved {
+std::mutex &fftw_mutex() {
+    static std::mutex m;
+    return m;
+}
+} // namespace js8core::improved
+
+Q_LOGGING_CATEGORY(decoder_js8, "decoder.js8", QtWarningMsg)
+
+namespace js8core {
+
+namespace {
+
+events::Variant convert(JS8::Event::Variant const &in) {
+    return std::visit(
+        [](auto const &e) -> events::Variant {
+            using E = std::decay_t<decltype(e)>;
+            if constexpr (std::is_same_v<E, JS8::Event::DecodeStarted>) {
+                return events::DecodeStarted{e.submodes};
+            } else if constexpr (std::is_same_v<E, JS8::Event::SyncStart>) {
+                return events::SyncStart{e.position, e.size};
+            } else if constexpr (std::is_same_v<E, JS8::Event::SyncState>) {
+                events::SyncState s;
+                s.kind = e.type == JS8::Event::SyncState::Type::DECODED
+                             ? events::SyncState::Kind::Decoded
+                             : events::SyncState::Kind::Candidate;
+                s.mode = e.mode;
+                s.frequency = e.frequency;
+                s.dt = e.dt;
+                if (s.kind == events::SyncState::Kind::Decoded) s.sync.decoded = e.sync.decoded;
+                else s.sync.candidate = e.sync.candidate;
+                return s;
+            } else if constexpr (std::is_same_v<E, JS8::Event::Decoded>) {
+                events::Decoded d;
+                d.utc = e.utc;
+                d.snr = e.snr;
+                d.xdt = e.xdt;
+                d.frequency = e.frequency;
+                d.data = e.data;
+                d.type = e.type;
+                d.quality = e.quality;
+                d.mode = e.mode;
+                return d;
+            } else {
+                return events::DecodeFinished{e.decoded};
+            }
+        },
+        in);
+}
+
+// One decoder per submode, created on first use and kept for the life of the
+// decode thread, like upstream's Worker::Impl.
+struct Decoders {
+    using Duration = js8::OptionalWorkBudget::Duration;
+    static constexpr std::size_t kStages = js8::OptionalWorkBudget::stages;
+
+    std::unique_ptr<::DecodeMode<::ModeA>> a;
+    std::unique_ptr<::DecodeMode<::ModeB>> b;
+    std::unique_ptr<::DecodeMode<::ModeC>> c;
+    std::unique_ptr<::DecodeMode<::ModeE>> e;
+    std::unique_ptr<::DecodeMode<::ModeI>> i;
+    std::unique_ptr<dec_data> data = std::make_unique<dec_data>();
+
+    // Learned cost of each submode's pass and of each optional stage, used to
+    // skip optional work when the next decode is due (order: I, E, C, B, A).
+    std::array<Duration, 5> mode_cost{};
+    std::array<std::array<Duration, kStages>, 5> stage_cost{};
+    std::array<bool, 5> mode_observed{};
+};
+
+} // namespace
+
+std::size_t improved_decode(DecodeState const &state,
+                            std::function<void(events::Variant const &)> emit_fn,
+                            std::chrono::steady_clock::time_point next_ready) {
+    static thread_local Decoders decoders;
+    auto &d = *decoders.data;
+
+    // Upstream's decode data: the sample ring and parameters.
+    std::size_t const n = std::min<std::size_t>(state.samples.size(), JS8_RX_SAMPLE_SIZE);
+    std::copy_n(state.samples.begin(), n, d.d2);
+    std::fill(d.d2 + n, d.d2 + JS8_RX_SAMPLE_SIZE, std::int16_t{0});
+    auto const &p = state.params;
+    d.params.nutc = p.utc;
+    d.params.nfqso = p.nfqso;
+    d.params.newdat = p.newdat;
+    d.params.nfa = p.nfa;
+    d.params.nfb = p.nfb;
+    d.params.syncStats = p.syncStats;
+    d.params.kin = p.kin;
+    d.params.kposA = p.kposA; d.params.kposB = p.kposB; d.params.kposC = p.kposC;
+    d.params.kposE = p.kposE; d.params.kposI = p.kposI;
+    d.params.kszA = p.kszA; d.params.kszB = p.kszB; d.params.kszC = p.kszC;
+    d.params.kszE = p.kszE; d.params.kszI = p.kszI;
+    d.params.nsubmodes = p.nsubmodes;
+
+    JS8::Event::Emitter emit = [&](JS8::Event::Variant const &event) {
+        if (emit_fn) emit_fn(convert(event));
+    };
+
+    // Deadline for optional work: none means "do everything".
+    js8::OptionalWorkSignal signal;
+    bool const bounded = next_ready != std::chrono::steady_clock::time_point{};
+    if (bounded) signal.nextReady(next_ready);
+
+    int const set = p.nsubmodes;
+    std::size_t total = 0;
+    emit(JS8::Event::DecodeStarted{set});
+
+    struct Entry { int bit; int kpos; int ksz; };
+    std::array<Entry, 5> const entries{{
+        {4, p.kposI, p.kszI}, {3, p.kposE, p.kszE}, {2, p.kposC, p.kszC},
+        {1, p.kposB, p.kszB}, {0, p.kposA, p.kszA}}};
+
+    for (std::size_t index = 0; index < entries.size(); ++index) {
+        auto const &entry = entries[index];
+        if ((set & (1 << entry.bit)) == 0) continue;
+
+        Decoders::Duration reserve{0};
+        bool unknown_mandatory = false;
+        for (std::size_t later = index + 1; later < entries.size(); ++later) {
+            if ((set & (1 << entries[later].bit)) == 0) continue;
+            if (!decoders.mode_observed[later]) unknown_mandatory = true;
+            else reserve += decoders.mode_cost[later];
+        }
+        js8::OptionalWorkBudget budget{bounded ? &signal : nullptr, reserve,
+                                       decoders.stage_cost[index], unknown_mandatory};
+        auto const started = js8::OptionalWorkBudget::Clock::now();
+
+        auto run = [&](auto &ptr) {
+            using Mode = typename std::remove_reference_t<decltype(ptr)>::element_type;
+            if (!ptr) ptr = std::make_unique<Mode>();
+            return (*ptr)(d, entry.kpos, entry.ksz, emit, &budget);
+        };
+        switch (entry.bit) {
+        case 4: total += run(decoders.i); break;
+        case 3: total += run(decoders.e); break;
+        case 2: total += run(decoders.c); break;
+        case 1: total += run(decoders.b); break;
+        default: total += run(decoders.a); break;
+        }
+
+        auto const took = std::chrono::duration_cast<Decoders::Duration>(
+            js8::OptionalWorkBudget::Clock::now() - started);
+        decoders.mode_cost[index] = std::max(decoders.mode_cost[index] * 9 / 10, took + took / 4);
+        decoders.mode_observed[index] = true;
+    }
+
+    emit(JS8::Event::DecodeFinished{total});
+    return total;
+}
+
+} // namespace js8core
