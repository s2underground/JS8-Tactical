diff --git a/src/decoder/decoder_select.cpp b/src/decoder/decoder_select.cpp
new file mode 100644
index 0000000..9815cff
--- /dev/null
+++ b/src/decoder/decoder_select.cpp
@@ -0,0 +1,39 @@
+#include "js8core/decoder.hpp"
+
+#include <atomic>
+
+namespace js8core {
+
+namespace {
+std::atomic<bool> g_improved{false};
+}
+
+void set_improved_decoder_enabled(bool enabled) noexcept { g_improved.store(enabled, std::memory_order_relaxed); }
+
+bool improved_decoder_enabled() noexcept {
+#if defined(JS8CORE_HAS_IMPROVED_DECODER)
+    return g_improved.load(std::memory_order_relaxed);
+#else
+    return false;
+#endif
+}
+
+std::size_t run_decoder(DecodeState const& state, std::function<void(events::Variant const&)> emit) {
+#if defined(JS8CORE_HAS_IMPROVED_DECODER)
+    if (improved_decoder_enabled()) {
+        // Skip optional work that would run past the next decode of the
+        // fastest submode in this pass (4 s Ultra … 30 s Slow), keeping 20 %.
+        int const set = state.params.nsubmodes;
+        int seconds = 30;
+        if (set & (1 << 0)) seconds = 15;
+        if (set & (1 << 1)) seconds = 10;
+        if (set & (1 << 2)) seconds = 6;
+        if (set & (1 << 4)) seconds = 4;
+        auto const next = std::chrono::steady_clock::now() + std::chrono::milliseconds(seconds * 800);
+        return improved_decode(state, std::move(emit), next);
+    }
+#endif
+    return legacy_decode(state, std::move(emit));
+}
+
+}  // namespace js8core
diff --git a/src/decoder/improved/compat/JS8.h b/src/decoder/improved/compat/JS8.h
new file mode 100644
index 0000000..21d37ce
--- /dev/null
+++ b/src/decoder/improved/compat/JS8.h
@@ -0,0 +1,64 @@
+// The parts of JS8Call-improved's JS8_Mode/JS8.h that the decoder uses, without
+// the Qt Decoder/Worker classes: Costas arrays, decode events and encode().
+#pragma once
+// Same guard name as upstream JS8.h: FrequencyTracker.h checks it to pull in
+// the interference-cancellation helpers for the decoder.
+#ifndef __JS8
+#define __JS8
+#endif
+#include <array>
+#include <cstddef>
+#include <functional>
+#include <string>
+#include <type_traits>
+#include <variant>
+
+namespace JS8 {
+namespace Costas {
+enum class Type { ORIGINAL, MODIFIED };
+
+using Array = std::array<std::array<int, 7>, 3>;
+
+constexpr auto array = [] {
+    constexpr auto COSTAS =
+        std::array{std::array{std::array{4, 2, 5, 6, 1, 3, 0},
+                              std::array{4, 2, 5, 6, 1, 3, 0},
+                              std::array{4, 2, 5, 6, 1, 3, 0}},
+                   std::array{std::array{0, 6, 2, 3, 5, 4, 1},
+                              std::array{1, 5, 0, 2, 3, 6, 4},
+                              std::array{2, 5, 0, 6, 4, 1, 3}}};
+
+    return [COSTAS](Type type) -> Array const & {
+        return COSTAS[static_cast<std::underlying_type_t<Type>>(type)];
+    };
+}();
+} // namespace Costas
+
+void encode(int type, Costas::Array const &costas, const char *message, int *tones);
+
+namespace Event {
+struct DecodeStarted { int submodes; };
+struct SyncStart { int position; int size; };
+struct SyncState {
+    enum class Type { CANDIDATE, DECODED } type;
+    int mode;
+    float frequency;
+    float dt;
+    union { int candidate; float decoded; } sync;
+};
+struct Decoded {
+    int utc;
+    int snr;
+    float xdt;
+    float frequency;
+    std::string data;
+    int type;
+    float quality;
+    int mode;
+};
+struct DecodeFinished { std::size_t decoded; };
+
+using Variant = std::variant<DecodeStarted, SyncStart, SyncState, Decoded, DecodeFinished>;
+using Emitter = std::function<void(Variant const &)>;
+} // namespace Event
+} // namespace JS8
