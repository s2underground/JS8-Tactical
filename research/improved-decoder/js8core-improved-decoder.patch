diff --git a/src/decoder/improved/compat/boost/multi_index_container.hpp b/src/decoder/improved/compat/boost/multi_index_container.hpp
new file mode 100644
index 0000000..5eb850b
--- /dev/null
+++ b/src/decoder/improved/compat/boost/multi_index_container.hpp
@@ -0,0 +1,177 @@
+// Minimal stand-in for boost::multi_index_container, enough for the decoder's
+// sync-candidate index: ordered_non_unique / ranked_non_unique views selected
+// by tag, with begin/end, lower_bound/upper_bound, erase(range), modify(it, f),
+// nth(k) and size(). Elements live in insertion order; each view keeps a sorted
+// list of element positions, rebuilt only when an element was modified. Equal
+// keys keep insertion order, as in Boost. Erased elements are skipped.
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <functional>
+#include <tuple>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+namespace boost::multi_index {
+
+template <typename... Tags> struct tag {};
+
+template <auto Member> struct key {
+    template <typename V> static decltype(auto) get(V const &v) { return v.*Member; }
+};
+
+template <typename Tag, typename Key, typename Compare = std::less<>>
+struct ordered_non_unique {
+    using tag_type = Tag;
+    using key_type = Key;
+    using compare_type = Compare;
+};
+
+template <typename Tag, typename Key, typename Compare = std::less<>>
+struct ranked_non_unique : ordered_non_unique<Tag, Key, Compare> {};
+
+template <typename... Indices> struct indexed_by {};
+
+template <typename Value, typename Indices> class multi_index_container;
+
+template <typename Value, typename... Indices>
+class multi_index_container<Value, indexed_by<Indices...>> {
+    std::vector<Value> items_;
+    std::vector<char> alive_;
+    std::size_t live_ = 0;
+    std::size_t version_ = 0; // bumped when values may have changed order
+
+  public:
+    template <typename Index> class view {
+        friend class multi_index_container;
+        multi_index_container *c_;
+        std::vector<std::size_t> order_;
+        std::size_t built_ = static_cast<std::size_t>(-1);
+        std::size_t built_count_ = static_cast<std::size_t>(-1);
+
+        using Key = typename Index::key_type;
+        using Cmp = typename Index::compare_type;
+
+        explicit view(multi_index_container *c) : c_(c) {}
+
+        void sync() {
+            if (built_ == c_->version_ && built_count_ == c_->items_.size()) return;
+            order_.resize(c_->items_.size());
+            for (std::size_t i = 0; i < order_.size(); ++i) order_[i] = i;
+            auto const &items = c_->items_;
+            std::stable_sort(order_.begin(), order_.end(), [&](std::size_t a, std::size_t b) {
+                return Cmp{}(Key::get(items[a]), Key::get(items[b]));
+            });
+            built_ = c_->version_;
+            built_count_ = c_->items_.size();
+        }
+
+        std::size_t skip(std::size_t pos) const {
+            while (pos < order_.size() && !c_->alive_[order_[pos]]) ++pos;
+            return pos;
+        }
+
+      public:
+        class iterator {
+            friend class view;
+            view const *v_ = nullptr;
+            std::size_t pos_ = 0;
+            iterator(view const *v, std::size_t pos) : v_(v), pos_(pos) {}
+
+          public:
+            iterator() = default;
+            Value const &operator*() const { return v_->c_->items_[v_->order_[pos_]]; }
+            Value const *operator->() const { return &**this; }
+            iterator &operator++() { pos_ = v_->skip(pos_ + 1); return *this; }
+            iterator operator++(int) { auto t = *this; ++*this; return t; }
+            bool operator==(iterator const &o) const { return pos_ == o.pos_; }
+            bool operator!=(iterator const &o) const { return pos_ != o.pos_; }
+        };
+        using const_iterator = iterator;
+
+        iterator begin() { sync(); return iterator(this, skip(0)); }
+        iterator end() { return iterator(this, order_.size()); }
+        std::size_t size() const { return c_->live_; }
+        bool empty() const { return c_->live_ == 0; }
+
+        template <typename K> iterator lower_bound(K const &k) {
+            sync();
+            auto const &items = c_->items_;
+            auto it = std::lower_bound(order_.begin(), order_.end(), k, [&](std::size_t i, K const &key) {
+                return Cmp{}(Key::get(items[i]), key);
+            });
+            return iterator(this, skip(static_cast<std::size_t>(it - order_.begin())));
+        }
+
+        template <typename K> iterator upper_bound(K const &k) {
+            sync();
+            auto const &items = c_->items_;
+            auto it = std::upper_bound(order_.begin(), order_.end(), k, [&](K const &key, std::size_t i) {
+                return Cmp{}(key, Key::get(items[i]));
+            });
+            return iterator(this, skip(static_cast<std::size_t>(it - order_.begin())));
+        }
+
+        /// The k-th element in this view's order (ranked indices).
+        iterator nth(std::size_t k) {
+            sync();
+            std::size_t pos = skip(0);
+            while (k-- > 0 && pos < order_.size()) pos = skip(pos + 1);
+            return iterator(this, pos);
+        }
+
+        template <typename F> bool modify(iterator it, F f) {
+            f(c_->items_[order_[it.pos_]]);
+            // Other views may now be out of order; this view's positions stay
+            // valid until its next begin()/bound/nth, as in the decoder's use.
+            ++c_->version_;
+            built_ = c_->version_;
+            return true;
+        }
+
+        iterator erase(iterator first, iterator last) {
+            for (std::size_t p = first.pos_; p < last.pos_ && p < order_.size(); ++p) {
+                std::size_t const idx = order_[p];
+                if (c_->alive_[idx]) { c_->alive_[idx] = 0; --c_->live_; }
+            }
+            return iterator(this, skip(last.pos_));
+        }
+    };
+
+  private:
+    std::tuple<view<Indices>...> views_{view<Indices>(this)...};
+
+    template <typename Tag, std::size_t I = 0> static constexpr std::size_t index_of() {
+        static_assert(I < sizeof...(Indices), "unknown multi_index tag");
+        using Index = std::tuple_element_t<I, std::tuple<Indices...>>;
+        if constexpr (std::is_same_v<typename Index::tag_type, tag<Tag>>) return I;
+        else return index_of<Tag, I + 1>();
+    }
+
+  public:
+    multi_index_container() = default;
+    multi_index_container(multi_index_container const &) = delete;
+    multi_index_container &operator=(multi_index_container const &) = delete;
+
+    template <typename Tag> auto &get() { return std::get<index_of<Tag>()>(views_); }
+
+    template <typename... Args> void emplace(Args &&...args) {
+        items_.emplace_back(std::forward<Args>(args)...);
+        alive_.push_back(1);
+        ++live_;
+    }
+
+    void clear() {
+        items_.clear();
+        alive_.clear();
+        live_ = 0;
+        ++version_;
+    }
+
+    bool empty() const noexcept { return live_ == 0; }
+    std::size_t size() const noexcept { return live_; }
+};
+
+} // namespace boost::multi_index
diff --git a/src/decoder/improved/compat/fftw3.h b/src/decoder/improved/compat/fftw3.h
new file mode 100644
index 0000000..117b6e0
--- /dev/null
+++ b/src/decoder/improved/compat/fftw3.h
@@ -0,0 +1,61 @@
+// FFTW single-precision API subset used by the JS8Call-improved decoder,
+// implemented on pocketfft (header-only, already used by js8core). Only the
+// calls the decoder makes: 1-D complex and real-to-complex plans, execute,
+// destroy. Plans remember their arrays, as FFTW plans do.
+#pragma once
+#include <complex>
+#include <cstddef>
+#include <vector>
+
+#ifndef POCKETFFT_CACHE_SIZE
+#define POCKETFFT_CACHE_SIZE 1000000
+#endif
+#include "pocketfft/pocketfft_hdronly.h"
+
+typedef float fftwf_complex[2];
+
+#define FFTW_FORWARD (-1)
+#define FFTW_BACKWARD (+1)
+#define FFTW_MEASURE (0U)
+#define FFTW_ESTIMATE (1U << 6)
+#define FFTW_PATIENT (1U << 5)
+#define FFTW_ESTIMATE_PATIENT FFTW_ESTIMATE
+
+struct js8_fftwf_plan_s {
+    enum Kind { C2C, R2C } kind;
+    std::size_t n;
+    void *in;
+    void *out;
+    bool forward;
+};
+typedef js8_fftwf_plan_s *fftwf_plan;
+
+inline fftwf_plan fftwf_plan_dft_1d(int n, fftwf_complex *in, fftwf_complex *out, int sign, unsigned) {
+    return new js8_fftwf_plan_s{js8_fftwf_plan_s::C2C, static_cast<std::size_t>(n), in, out, sign == FFTW_FORWARD};
+}
+
+inline fftwf_plan fftwf_plan_dft_r2c_1d(int n, float *in, fftwf_complex *out, unsigned) {
+    return new js8_fftwf_plan_s{js8_fftwf_plan_s::R2C, static_cast<std::size_t>(n), in, out, true};
+}
+
+inline void fftwf_execute(fftwf_plan const p) {
+    if (!p) return;
+    pocketfft::shape_t const shape{p->n};
+    auto *out = reinterpret_cast<std::complex<float> *>(p->out);
+    if (p->kind == js8_fftwf_plan_s::C2C) {
+        pocketfft::stride_t const stride{static_cast<std::ptrdiff_t>(sizeof(std::complex<float>))};
+        pocketfft::c2c(shape, stride, stride, {0}, p->forward,
+                       reinterpret_cast<std::complex<float> const *>(p->in), out, 1.0f, 1);
+    } else {
+        // FFTW r2c may run in place (input aliased with output); pocketfft
+        // needs separate buffers, so copy the input first in that case.
+        auto const *in = reinterpret_cast<float const *>(p->in);
+        std::vector<float> copy;
+        if (p->in == p->out) { copy.assign(in, in + p->n); in = copy.data(); }
+        pocketfft::stride_t const sin{static_cast<std::ptrdiff_t>(sizeof(float))};
+        pocketfft::stride_t const sout{static_cast<std::ptrdiff_t>(sizeof(std::complex<float>))};
+        pocketfft::r2c(shape, sin, sout, 0, true, in, out, 1.0f, 1);
+    }
+}
+
+inline void fftwf_destroy_plan(fftwf_plan p) { delete p; }
diff --git a/src/decoder/improved/compat/qt_shim.h b/src/decoder/improved/compat/qt_shim.h
new file mode 100644
index 0000000..05bb87b
--- /dev/null
+++ b/src/decoder/improved/compat/qt_shim.h
@@ -0,0 +1,57 @@
+// Stand-ins for the few Qt pieces the JS8Call-improved decoder uses: debug
+// logging (compiled out) and environment-variable switches. Not Qt.
+#pragma once
+#include <cstdlib>
+#include <cstring>
+
+class QLoggingCategory {
+  public:
+    bool isDebugEnabled() const noexcept { return false; }
+    bool isInfoEnabled() const noexcept { return false; }
+    bool isWarningEnabled() const noexcept { return false; }
+};
+
+// Swallows anything streamed into it.
+class QDebug {
+  public:
+    template <typename T> QDebug &operator<<(T const &) { return *this; }
+    QDebug &noquote() { return *this; }
+    QDebug &nospace() { return *this; }
+    QDebug &space() { return *this; }
+    QDebug &quote() { return *this; }
+};
+
+enum QtMsgType { QtDebugMsg, QtWarningMsg, QtCriticalMsg, QtFatalMsg, QtInfoMsg };
+
+#define Q_DECLARE_LOGGING_CATEGORY(name) QLoggingCategory &name()
+#define Q_LOGGING_CATEGORY(name, ...)                                          \
+    QLoggingCategory &name() {                                                 \
+        static QLoggingCategory category;                                      \
+        return category;                                                       \
+    }
+// A single statement that never runs, so it is safe inside if/else.
+#define qCDebug(category) while (false) QDebug()
+#define qCInfo(category) while (false) QDebug()
+#define qCWarning(category) while (false) QDebug()
+#define qDebug() while (false) QDebug()
+#define qWarning() while (false) QDebug()
+
+inline bool qEnvironmentVariableIsSet(char const *name) noexcept {
+    char const *v = std::getenv(name);
+    return v != nullptr && *v != '\0';
+}
+
+inline int qEnvironmentVariableIntValue(char const *name, bool *ok = nullptr) noexcept {
+    char const *v = std::getenv(name);
+    if (ok) *ok = false;
+    if (!v || !*v) return 0;
+    char *end = nullptr;
+    long value = std::strtol(v, &end, 0);
+    if (end == v || *end != '\0') return 0;
+    if (ok) *ok = true;
+    return static_cast<int>(value);
+}
+
+template <typename T> constexpr T const &qBound(T const &lo, T const &v, T const &hi) {
+    return v < lo ? lo : (hi < v ? hi : v);
+}
