<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of JS8-Tactical's leaves the device through Android backup or device-to-device transfer
  (Android 12 and later). The app holds message history, held messages, callsigns, grids, rosters
  and radio settings; a backup would copy all of it off the phone for no real gain (another
  device usually means another radio and other settings). On Android 11 and earlier,
  android:allowBackup="false" covers cloud and adb backup; on Android 12 and later it no longer
  covers device-to-device transfer, which is why these rules exclude every domain from both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
