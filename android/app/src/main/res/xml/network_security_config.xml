<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only, trusting only the system's certificate authorities. Every web request the app makes is
  HTTPS (space-weather data, map tiles, optional AI model downloads). Radio connections such as
  rigctld use plain TCP sockets, which this file does not affect.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
