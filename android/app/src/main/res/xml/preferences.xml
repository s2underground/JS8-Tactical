<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Station Info Category -->
    <PreferenceCategory
        app:title="@string/settings_category_general"
        app:iconSpaceReserved="false">

        <Preference
            app:key="open_library"
            app:title="@string/settings_library"
            app:summary="@string/settings_library_summary"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="user_role"
            app:title="@string/settings_role"
            app:entries="@array/role_entries"
            app:entryValues="@array/role_values"
            app:defaultValue="operator"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />


        <EditTextPreference
            app:key="callsign"
            app:title="@string/settings_callsign"
            app:summary="@string/settings_callsign_summary"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <com.js8call.example.ui.GridSquarePreference
            app:key="grid"
            app:title="@string/settings_grid"
            app:summary="@string/settings_grid_summary"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="my_info"
            app:title="@string/settings_info"
            app:summary="@string/settings_info_summary"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="my_groups"
            app:title="@string/settings_groups"
            app:summary="@string/settings_groups_summary"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="my_status"
            app:title="@string/settings_status"
            app:summary="@string/settings_status_summary"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Audio Category -->
    <PreferenceCategory
        app:title="@string/settings_category_audio"
        app:iconSpaceReserved="false">

        <Preference
            app:key="audio_device"
            app:title="@string/settings_audio_device"
            app:persistent="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="tx_boost_enabled"
            app:title="@string/settings_tx_boost"
            app:summary="@string/settings_tx_boost_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="vox_lead_seconds"
            app:title="@string/settings_vox_lead"
            app:entries="@array/vox_lead_entries"
            app:entryValues="@array/vox_lead_values"
            app:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Radio Category -->
    <PreferenceCategory
        app:title="@string/settings_category_radio"
        app:iconSpaceReserved="false">

        <EditTextPreference
            app:key="custom_frequency_mhz"
            app:title="@string/settings_custom_frequency"
            app:summary="@string/settings_custom_frequency_summary"
            android:inputType="numberDecimal"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="rig_control_enabled"
            app:title="@string/settings_rig_control"
            app:summary="@string/settings_rig_control_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="rig_type"
            app:title="@string/settings_rig_type"
            app:summary="@string/settings_rig_type_summary"
            app:entries="@array/rig_type_entries"
            app:entryValues="@array/rig_type_values"
            app:defaultValue="none"
            app:dependency="rig_control_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="transmit_mode"
            app:title="@string/settings_transmit_mode"
            app:summary="@string/settings_transmit_mode_summary"
            app:entries="@array/transmit_mode_entries"
            app:entryValues="@array/transmit_mode_values"
            app:defaultValue="none"
            app:dependency="rig_control_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="rigctld_host"
            app:title="@string/settings_rigctld_host"
            app:summary="@string/settings_rigctld_host_summary"
            app:defaultValue="localhost"
            app:dependency="rig_control_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="rigctld_port"
            app:title="@string/settings_rigctld_port"
            app:summary="@string/settings_rigctld_port_summary"
            app:defaultValue="4532"
            app:dependency="rig_control_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <PreferenceCategory
            app:title="@string/settings_hamlib_usb_category"
            app:dependency="rig_control_enabled"
            app:iconSpaceReserved="false">

            <ListPreference
                app:key="rig_hamlib_model"
                app:title="@string/settings_hamlib_model"
                app:summary="@string/settings_hamlib_model_summary"
                app:defaultValue="0"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />

            <ListPreference
                app:key="rig_hamlib_usb_port"
                app:title="@string/settings_hamlib_usb_port"
                app:summary="@string/settings_hamlib_usb_port_summary"
                app:defaultValue="auto"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />

            <EditTextPreference
                app:key="rig_serial_baud"
                app:title="@string/settings_hamlib_baud_rate"
                app:summary="@string/settings_hamlib_baud_rate_summary"
                app:defaultValue="9600"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />

            <ListPreference
                app:key="rig_serial_data_bits"
                app:title="@string/settings_hamlib_data_bits"
                app:summary="@string/settings_hamlib_data_bits_summary"
                app:entries="@array/serial_data_bits_entries"
                app:entryValues="@array/serial_data_bits_values"
                app:defaultValue="8"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />

            <ListPreference
                app:key="rig_serial_stop_bits"
                app:title="@string/settings_hamlib_stop_bits"
                app:summary="@string/settings_hamlib_stop_bits_summary"
                app:entries="@array/serial_stop_bits_entries"
                app:entryValues="@array/serial_stop_bits_values"
                app:defaultValue="1"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />

            <ListPreference
                app:key="rig_serial_parity"
                app:title="@string/settings_hamlib_parity"
                app:summary="@string/settings_hamlib_parity_summary"
                app:entries="@array/serial_parity_entries"
                app:entryValues="@array/serial_parity_values"
                app:defaultValue="none"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />

        </PreferenceCategory>

        <PreferenceCategory
            app:title="@string/settings_qmx_category"
            app:dependency="rig_control_enabled"
            app:iconSpaceReserved="false">

            <ListPreference
                app:key="qmx_band_profile"
                app:title="@string/settings_qmx_band_profile"
                app:summary="@string/settings_qmx_band_profile_summary"
                app:entries="@array/qmx_band_profile_entries"
                app:entryValues="@array/qmx_band_profile_values"
                app:defaultValue="low"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />

            <EditTextPreference
                app:key="qmx_cat_baud"
                app:title="@string/settings_qmx_cat_baud"
                app:summary="@string/settings_qmx_cat_baud_summary"
                app:defaultValue="115200"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>

    </PreferenceCategory>

    <!-- Network Category -->
    <PreferenceCategory
        app:title="@string/settings_category_network"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="psk_reporter"
            app:title="@string/settings_psk_reporter"
            app:summary="@string/settings_psk_reporter_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <!-- TODO: Enable when APRS-IS support is implemented. -->
        <!--
        <SwitchPreferenceCompat
            app:key="aprs_is"
            app:title="@string/settings_aprs_is"
            app:summary="@string/settings_aprs_is_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
        -->

    </PreferenceCategory>

    <!-- Message history Category -->
    <PreferenceCategory
        app:title="@string/settings_category_history"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="history_keep_hours"
            app:title="@string/settings_history_keep"
            app:entries="@array/history_keep_entries"
            app:entryValues="@array/history_keep_values"
            app:defaultValue="168"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="history_clear"
            app:title="@string/settings_history_clear"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- ATAK Category -->
    <PreferenceCategory
        app:title="@string/settings_category_atak"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="atak_enabled"
            app:title="@string/settings_atak_enabled"
            app:summary="@string/settings_atak_enabled_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="atak_legend"
            app:title="@string/settings_atak_legend"
            app:selectable="false"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="atak_help"
            app:title="@string/settings_atak_help"
            app:summary="@string/settings_atak_help_summary"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="atak_target"
            app:title="@string/settings_atak_target"
            app:entries="@array/atak_target_entries"
            app:entryValues="@array/atak_target_values"
            app:defaultValue="local"
            app:dependency="atak_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="atak_host"
            app:title="@string/settings_atak_host"
            app:defaultValue="127.0.0.1"
            app:dependency="atak_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            app:key="atak_port"
            app:title="@string/settings_atak_port"
            app:defaultValue="4242"
            app:dependency="atak_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="atak_stations"
            app:title="@string/settings_atak_stations"
            app:summary="@string/settings_atak_stations_summary"
            app:defaultValue="false"
            app:dependency="atak_enabled"
            app:iconSpaceReserved="false" />

        <ListPreference
            app:key="atak_stale_hours"
            app:title="@string/settings_atak_stale"
            app:entries="@array/atak_stale_entries"
            app:entryValues="@array/atak_stale_values"
            app:defaultValue="24"
            app:dependency="atak_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="atak_test"
            app:title="@string/settings_atak_test"
            app:dependency="atak_enabled"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="atak_remove"
            app:title="@string/settings_atak_remove"
            app:summary="@string/settings_atak_remove_summary"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- General Category -->
    <PreferenceCategory
        app:title="@string/settings_category_general"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="keep_receiving_when_closed"
            app:title="@string/settings_keep_receiving"
            app:summary="@string/settings_keep_receiving_summary"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="autoreply_enabled"
            app:title="@string/settings_autoreply"
            app:summary="@string/settings_autoreply_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="relay_enabled"
            app:title="@string/settings_relay"
            app:summary="@string/settings_relay_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="keep_screen_on"
            app:title="@string/settings_keep_screen_on"
            app:summary="@string/settings_keep_screen_on_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="persist_decodes"
            app:title="@string/settings_persist_decodes"
            app:summary="@string/settings_persist_decodes_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="log_messages_to_file"
            app:title="@string/settings_log_messages"
            app:summary="@string/settings_log_messages_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Heartbeat Category -->
    <PreferenceCategory
        app:title="@string/settings_category_heartbeat"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="heartbeat_interval"
            app:title="@string/settings_heartbeat_interval"
            app:summary="@string/settings_heartbeat_interval_summary"
            app:entries="@array/heartbeat_interval_entries"
            app:entryValues="@array/heartbeat_interval_values"
            app:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="hb_offset"
            app:title="@string/hb_offset_title"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Timing Category -->
    <PreferenceCategory
        app:title="@string/settings_category_timing"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="time_sync_auto"
            app:title="@string/settings_time_sync_auto"
            app:summary="@string/settings_time_sync_auto_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Diagnostics: a report to send when something goes wrong -->
    <PreferenceCategory
        app:title="Diagnostics"
        app:iconSpaceReserved="false">

        <Preference
            app:key="diagnostics_last_error"
            app:title="Last error report"
            app:summary="Show the most recent error report again, with the Copy button."
            app:iconSpaceReserved="false" />

        <Preference
            app:key="diagnostics_share"
            app:title="Share diagnostic report"
            app:summary="Past crash and freeze reports, the app's recent log and radio setup (no callsign or grid). Nothing is sent unless you share it."
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

<!-- About Category -->
    <PreferenceCategory
        app:title="@string/settings_category_ai"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="ai_enabled"
            app:title="@string/settings_ai_enabled"
            app:summary="@string/settings_ai_enabled_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="ai_double_check"
            app:title="@string/settings_ai_double_check"
            app:summary="@string/settings_ai_double_check_summary"
            app:defaultValue="true"
            app:dependency="ai_enabled"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="open_ai"
            app:title="@string/settings_ai_open"
            app:summary="@string/settings_ai_open_summary"
            app:dependency="ai_enabled"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/settings_category_about"
        app:iconSpaceReserved="false">

        <Preference
            app:key="app_version"
            app:title="@string/settings_version"
            app:selectable="false"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="about_licences"
            app:title="@string/about_licences"
            app:summary="@string/about_licences_summary"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
