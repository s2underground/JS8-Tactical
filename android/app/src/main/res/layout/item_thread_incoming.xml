<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="KN4XYZ" />

        <TextView
            android:id="@+id/card_report_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_tx"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/tac_ground"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="SALUTE"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/card_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/tac_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="→ @TEAM" />

        <TextView
            android:id="@+id/card_copies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_neutral"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/tac_chip_text"
            android:textSize="12sp"
            tools:text="3 copies merged" />

        <TextView
            android:id="@+id/card_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_good"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Complete" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/card_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/tac_text_dim"
            android:textSize="12sp"
            tools:text="13:18Z" />
    </LinearLayout>

    <TextView
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/tac_text"
        android:textIsSelectable="false"
        android:textSize="17sp"
        tools:text="ROAD BLOCKED AT BRIDGE, REROUTING VIA COUNTY 12, ETA 1630" />

    <GridLayout
        android:id="@+id/card_report_fields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:columnCount="3"
        android:useDefaultMargins="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/card_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/tac_text_dim"
        android:textSize="12sp"
        tools:text="first 13:12Z · last 13:18Z · +1450 Hz · -11 dB" />

    <LinearLayout
        android:id="@+id/card_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/card_resend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/tac_warn"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/traffic_request_resend"
            android:textColor="@color/tac_ground"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</LinearLayout>
