<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@color/tac_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/status_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/tac_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginHorizontal="14dp"
        android:background="@color/tac_border" />

    <TextView
        android:id="@+id/status_frequency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/tac_text"
        android:textSize="14sp"
        tools:text="7.078 MHz" />

    <TextView
        android:id="@+id/status_pill"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_pill_rx"
        android:contentDescription="@string/traffic_open_radio"
        android:gravity="center"
        android:minWidth="56dp"
        android:paddingHorizontal="12dp"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="RX" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/status_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/tac_text"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="13:42:18Z" />
</LinearLayout>
