<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tac_ground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/thread_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/tac_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="KN4XYZ" />

        <TextView
            android:id="@+id/thread_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tac_text_dim"
            android:textSize="13sp"
            tools:text="EM73 · +1450 Hz · -11 dB" />

        <!-- Relay finder / "via" state: shown while a station is selected. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/thread_relay"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/relay_find"
            android:textColor="@color/tac_text"
            android:visibility="gone"
            app:strokeColor="@color/tac_text_dim"
            tools:visibility="visible" />

        <!-- Back to everyone: shown while a station or group is selected. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/thread_clear"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/traffic_clear_selection"
            android:textColor="@color/tac_text"
            android:visibility="gone"
            app:icon="@drawable/ic_close_traffic"
            app:iconTint="@color/tac_text"
            app:strokeColor="@color/tac_text_dim"
            tools:visibility="visible" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tac_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/thread_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/thread_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/traffic_empty"
            android:textColor="@color/tac_text_dim"
            android:textSize="15sp" />

        <!-- Shown while scrolled up: new traffic no longer drags the list down; tap to follow again. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/thread_latest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="@string/traffic_latest"
            android:textColor="@color/tac_ground"
            android:visibility="gone"
            app:backgroundTint="@color/tac_accent"
            app:cornerRadius="20dp"
            app:elevation="6dp"
            app:icon="@drawable/ic_arrow_drop_down"
            app:iconTint="@color/tac_ground" />

        <!-- The Inbox opens here (Traffic → Inbox), keeping the waterfall and station list in view. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/inbox_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/tac_ground"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/live_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_live_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/live_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Receiving from KN4XYZ" />

        <TextView
            android:id="@+id/live_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/tac_text"
            android:textSize="14sp"
            tools:text="frame 2 · NEED 2 MORE VOLUNTEERS FOR" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tac_divider" />

    <HorizontalScrollView
        android:id="@+id/tpl_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tac_panel"
        android:paddingTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/tpl_heartbeat"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tpl_heartbeat"
                android:textColor="@color/tac_ground"
                app:chipBackgroundColor="@color/tac_accent"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tpl_cq"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tpl_cq" />

            <!-- Send speed (Slow / Normal / Fast / Turbo): saved, used for every send including heartbeats. -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tpl_speed"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:closeIcon="@drawable/ic_arrow_drop_down"
                app:closeIconTint="@color/tac_text_dim"
                app:closeIconVisible="true" />






            <com.google.android.material.chip.Chip
                android:id="@+id/chip_repeat3"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/traffic_send_x3" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <include layout="@layout/compose_bar" />
</LinearLayout>
