<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_traffic">

    <fragment
        android:id="@+id/navigation_traffic"
        android:name="com.js8call.example.ui.traffic.TrafficFragment"
        android:label="@string/nav_traffic" />

    <fragment
        android:id="@+id/navigation_map"
        android:name="com.js8call.example.ui.map.MapHostFragment"
        android:label="@string/nav_map" />

    <fragment
        android:id="@+id/navigation_nets"
        android:name="com.js8call.example.ui.nets.NetsFragment"
        android:label="@string/nav_nets" />

    <fragment
        android:id="@+id/navigation_propagation"
        android:name="com.js8call.example.ui.prop.PropagationFragment"
        android:label="@string/nav_propagation" />

    <fragment
        android:id="@+id/navigation_library"
        android:name="com.js8call.example.ui.library.LibraryFragment"
        android:label="@string/nav_library" />

    <fragment
        android:id="@+id/navigation_guide"
        android:name="com.js8call.example.ui.library.GuideFragment"
        android:label="@string/nav_library">
        <argument
            android:name="guide"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/navigation_team"
        android:name="com.js8call.example.ui.team.TeamFragment"
        android:label="@string/nav_team" />

    <fragment
        android:id="@+id/navigation_digest"
        android:name="com.js8call.example.ui.digest.DigestFragment"
        android:label="@string/nav_digest" />

    <fragment
        android:id="@+id/navigation_reports"
        android:name="com.js8call.example.ui.reports.ReportsFragment"
        android:label="@string/nav_reports" />

    <fragment
        android:id="@+id/navigation_report_edit"
        android:name="com.js8call.example.ui.reports.ReportEditorFragment"
        android:label="@string/nav_reports" />

    <fragment
        android:id="@+id/navigation_ai"
        android:name="com.js8call.example.ai.AiFragment"
        android:label="@string/ai_title" />

    <fragment
        android:id="@+id/navigation_net"
        android:name="com.js8call.example.ui.net.NetFragment"
        android:label="@string/nav_net" />

    <fragment
        android:id="@+id/navigation_monitor"
        android:name="com.js8call.example.ui.MonitorFragment"
        android:label="@string/nav_monitor" />

    <fragment
        android:id="@+id/navigation_messages"
        android:name="com.js8call.example.ui.MessagesFragment"
        android:label="@string/nav_messages">
        <action
            android:id="@+id/action_messages_to_conversation"
            app:destination="@id/navigation_conversation" />
        <action
            android:id="@+id/action_messages_to_everything"
            app:destination="@id/navigation_everything" />
    </fragment>

    <fragment
        android:id="@+id/navigation_everything"
        android:name="com.js8call.example.ui.EverythingFragment"
        android:label="@string/everything_title" />

    <fragment
        android:id="@+id/navigation_conversation"
        android:name="com.js8call.example.ui.ConversationFragment"
        android:label="{callsign}">
        <argument
            android:name="callsign"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.js8call.example.ui.SettingsFragment"
        android:label="@string/nav_settings" />
</navigation>
